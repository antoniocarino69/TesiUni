# Configurazione opzionale del PoC. I nomi CLOUD_* funzionano con qualunque
# provider che esponga il protocollo Chat Completions compatibile con OpenAI.

# Provider cloud OpenAI-compatible
# CLOUD_API_KEY=sk-...
# CLOUD_BASE_URL=https://api.example/v1
# CLOUD_MODEL=provider-model
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Langfuse: visibilità sperimentale della tesi; trace non coperti dal filtro DP.
# Cloud consentito con dati autorizzati; in deployment riservato usare istanza locale.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_CAPTURE_SENSITIVE=false
